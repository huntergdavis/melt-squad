{
  "name": "melt-squad",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
